+  .sidebar { position: fixed; top: 0; bottom: 0; left: 0; width: 272px; height: auto; transform: translateX(-104%); transition: transform .2s; }
+  .sidebar.open { transform: none; box-shadow: 18px 0 50px rgba(0, 0, 0, .45); }
+  .menubtn { display: inline-grid; }
+  .main { padding: 16px 14px 56px; }
+  .btn-text, .uname { display: none; }
+  .userchip { padding: 3px; }
