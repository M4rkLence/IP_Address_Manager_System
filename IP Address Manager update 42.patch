@@ -16,3 +16,11 @@ export function validateDevice(body) {
   const notes = String(b.notes ?? '').trim().slice(0, 200)
   return { value: { ip, name, type, status, notes } }
 }
+
+// Name of a department or router.
+export function validateName(body, label) {
+  const name = String((body && body.name) ?? '').replace(/\s+/g, ' ').trim()
+  if (!name) return { error: `${label} name is required.` }
+  if (name.length > 40) return { error: `${label} name must be 40 characters or fewer.` }
+  return { value: { name } }
+}
