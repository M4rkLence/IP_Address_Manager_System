diff --git a/server/validate.js b/server/validate.js
index 93501c5..676694a 100644
--- a/server/validate.js
+++ b/server/validate.js
@@ -4,8 +4,23 @@ import { TYPES, STATUSES } from './db.js'
 // Checks the JSON body of POST/PUT. Returns { error } or { value }.
 export function validateDevice(body) {
   const b = body && typeof body === 'object' ? body : {}
+
+  const routerId = Number(b.routerId)
+  if (!Number.isInteger(routerId) || routerId < 1) return { error: 'Choose a department and a router.' }
+
+  const ether = String(b.ether ?? '').replace(/\s+/g, ' ').trim()
+  if (!ether) return { error: 'Ethernet port is required, for example Gi0/0.' }
+  if (ether.length > 30) return { error: 'Ethernet port must be 30 characters or fewer.' }
+
   const ip = parseIp(b.ip)
   if (ip === null) return { error: 'IP address is not valid. Use four numbers from 0 to 255, like 192.168.1.10.' }
+
+  // the prefix may be typed as 24 or /24
+  const prefixText = String(b.prefix ?? '').replace('/', '').trim()
+  const prefix = Number(prefixText)
+  if (prefixText === '' || !Number.isInteger(prefix) || prefix < 0 || prefix > 32)
+    return { error: 'Prefix must be a whole number from 0 to 32, like 24.' }
+
   const name = String(b.name ?? '').trim()
   if (!name) return { error: 'Device name is required.' }
   if (name.length > 60) return { error: 'Device name must be 60 characters or fewer.' }
@@ -14,7 +29,7 @@ export function validateDevice(body) {
   const status = b.status ?? 'static'
   if (!STATUSES.includes(status)) return { error: 'Status must be static or dhcp.' }
   const notes = String(b.notes ?? '').trim().slice(0, 200)
-  return { value: { ip, name, type, status, notes } }
+  return { value: { routerId, ether, ip, prefix, name, type, status, notes } }
 }
 
 // Name of a department or router.
