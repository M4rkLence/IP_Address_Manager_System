diff --git a/client/src/Dashboard.jsx b/client/src/Dashboard.jsx
new file mode 100644
index 0000000..f4aafc2
--- /dev/null
+++ b/client/src/Dashboard.jsx
@@ -0,0 +1,118 @@
+import { useEffect, useState } from 'react'
+import { api } from './api.js'
+import DeviceForm from './components/DeviceForm.jsx'
+import DeviceTable from './components/DeviceTable.jsx'
+import SubnetGrid from './components/SubnetGrid.jsx'
+
+export default function Dashboard({ user, onLogout, onExpired }) {
+  const [devices, setDevices] = useState([])
+  const [types, setTypes] = useState(['PC'])
+  const [form, setForm] = useState({ key: 0, initial: {} })
+  const [formError, setFormError] = useState('')
+  const [suggestion, setSuggestion] = useState('')
+  const [cidrInput, setCidrInput] = useState('192.168.1.0/24')
+  const [cidr, setCidr] = useState('192.168.1.0/24')
+  const [subnet, setSubnet] = useState(null)
+  const [subnetError, setSubnetError] = useState('')
+  const [loadError, setLoadError] = useState('')
+
+  const loadDevices = () =>
+    api.listDevices().then(setDevices)
+      .catch((e) => (e.status === 401 ? onExpired() : setLoadError(e.message)))
+
+  useEffect(() => {
+    api.types().then(setTypes).catch(() => {})
+    loadDevices()
+  }, [])
+
+  // Redraw the subnet grid whenever the subnet or the device list changes.
+  useEffect(() => {
+    api.subnet(cidr)
+      .then((s) => { setSubnet(s); setSubnetError('') })
+      .catch((e) => {
+        if (e.status === 401) return onExpired()
+        setSubnet(null); setSubnetError(e.message)
+      })
+  }, [cidr, devices])
+
+  const resetForm = (initial = {}) => {
+    setFormError(''); setSuggestion('')
+    setForm((f) => ({ key: f.key + 1, initial }))
+  }
+
+  async function save(values) {
+    setFormError(''); setSuggestion('')
+    try {
+      if (form.initial.id) await api.updateDevice(form.initial.id, values)
+      else await api.createDevice(values)
+      resetForm()
+      await loadDevices()
+    } catch (e) {
+      if (e.status === 401) return onExpired()
+      setFormError(e.message)
+      setSuggestion(e.suggestion || '')
+    }
+  }
+
+  async function remove(d) {
+    if (!window.confirm(`Delete ${d.name} (${d.ip})?`)) return
+    try {
+      await api.deleteDevice(d.id)
+    } catch (e) {
+      if (e.status === 401) return onExpired()
+      throw e
+    }
+    if (form.initial.id === d.id) resetForm()
+    loadDevices()
+  }
+
+  return (
+    <main>
+      <header className="topbar">
+        <h1>IP address manager</h1>
+        <div className="who">
+          <span>Signed in as <b>{user.username}</b></span>
+          <button type="button" onClick={onLogout}>Log out</button>
+        </div>
+      </header>
+      <p className="sub">Keep track of which device uses which address, and spot conflicts before they happen.</p>
+      {loadError && <p className="error" role="alert">{loadError}</p>}
+
+      <DeviceForm
+        key={form.key}
+        initial={form.initial}
+        types={types}
+        error={formError}
+        suggestion={suggestion}
+        onSave={save}
+        onCancel={() => resetForm()}
+      />
+
+      <h2>Subnet map</h2>
+      <form className="subnetbar" onSubmit={(e) => { e.preventDefault(); setCidr(cidrInput.trim()) }}>
+        <input value={cidrInput} onChange={(e) => setCidrInput(e.target.value)}
+          aria-label="Subnet in CIDR form" className="mono" />
+        <button type="submit">Show subnet</button>
+      </form>
+      {subnetError && <p className="error" role="alert">{subnetError}</p>}
+      {subnet && (
+        <>
+          <p className="stats">
+            <b>{subnet.usedCount}</b> of <b>{subnet.usable}</b> addresses used.
+            {subnet.nextFree
+              ? <> Next free: <button type="button" className="link mono" onClick={() => resetForm({ ip: subnet.nextFree })}>{subnet.nextFree}</button></>
+              : ' No free addresses left.'}
+          </p>
+          <div className="legend">
+            <span><i className="cell used" /> Used</span>
+            <span><i className="cell free" /> Free (tap to use)</span>
+          </div>
+          <SubnetGrid subnet={subnet} onPick={(ip) => resetForm({ ip })} />
+        </>
+      )}
+
+      <h2>All devices</h2>
+      <DeviceTable devices={devices} onEdit={(d) => resetForm(d)} onDelete={remove} />
+    </main>
+  )
+}
