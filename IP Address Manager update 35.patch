@@ -0,0 +1,24 @@
+// Vertical bars with gridlines. data: [{ label, value }]
+export default function BarChart({ data, title }) {
+  if (!data.length) return <p className="empty">Pick a subnet to see its usage.</p>
+  const max = Math.max(4, ...data.map((d) => d.value))
+  const steps = [0, 0.25, 0.5, 0.75, 1]
+
+  return (
+    <div className="bars" role="img" aria-label={title}>
+      <div className="bars-grid">
+        {steps.map((s) => <span key={s} style={{ bottom: s * 100 + '%' }}><em>{Math.round(max * s)}</em></span>)}
+      </div>
+      <div className="bars-row">
+        {data.map((d) => (
+          <div className="bcol" key={d.label} title={`${d.label}: ${d.value} used`}>
+            <div className="btrack">
+              <div className="bfill" style={{ height: (d.value / max) * 100 + '%' }}><span>{d.value || ''}</span></div>
+            </div>
+            <small>{d.label}</small>
+          </div>
+        ))}
+      </div>
+    </div>
+  )
+}
diff --git a/client/src/components/charts/DonutChart.jsx b/client/src/components/charts/DonutChart.jsx
