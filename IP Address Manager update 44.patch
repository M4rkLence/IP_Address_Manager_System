+import { useState } from 'react'
+
+// A small dialog for the name of a department or a router.
+export default function NameForm({ title, label, placeholder, initial, submitLabel, error, onSave, onCancel }) {
+  const [name, setName] = useState(initial || '')
+  return (
+    <form className="form" onSubmit={(e) => { e.preventDefault(); onSave(name) }}>
+      <h2>{title}</h2>
+      <label>{label}
+        <input value={name} onChange={(e) => setName(e.target.value)} placeholder={placeholder} maxLength={40} autoFocus required />
+      </label>
+      {error && <p className="error" role="alert">{error}</p>}
+      <div className="actions">
+        <button type="submit" className="primary">{submitLabel}</button>
+        <button type="button" onClick={onCancel}>Cancel</button>
+      </div>
+    </form>
+  )
+}
