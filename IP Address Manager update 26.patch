+++ b/client/src/components/Header.jsx
@@ -0,0 +1,23 @@
+import Icon from './Icon.jsx'
+import ThemeToggle from './ThemeToggle.jsx'
+
+export default function Header({ user, onLogout }) {
+  return (
+    <header className="header">
+      <div className="brand">
+        <span className="logo"><Icon name="network" size={20} /></span>
+        <span>IP Manager</span>
+      </div>
+      <div className="header-right">
+        <ThemeToggle />
+        <div className="userchip" title={user.username}>
+          <span className="avatar">{user.username[0].toUpperCase()}</span>
+          <span className="uname">{user.username}</span>
+        </div>
+        <button type="button" className="btn" onClick={onLogout} aria-label="Log out">
+          <Icon name="logout" size={16} /><span className="btn-text">Log out</span>
+        </button>
+      </div>
+    </header>
+  )
+}
diff --git a/client/src/components/StatCards.jsx b/client/src/components/StatCards.jsx
new file mode 100644
index 0000000..9d85862
--- /dev/null
+++ b/client/src/components/StatCards.jsx
@@ -0,0 +1,42 @@
+export default function StatCards({ devices, subnet, onUse }) {
+  const staticCount = devices.filter((d) => d.status === 'static').length
+  const dhcpCount = devices.length - staticCount
+  const pct = subnet ? Math.round((subnet.usedCount / subnet.usable) * 100) : 0
+  const level = pct >= 90 ? 'hot' : pct >= 70 ? 'warm' : ''
+
+  return (
+    <section className="summary" aria-label="Summary">
+      <div className="stat">
+        <div className="stat-label">Devices</div>
+        <div className="stat-value">{devices.length}</div>
+        <div className="stat-sub">all of your devices</div>
+      </div>
+
+      <div className="stat">
+        <div className="stat-label">Subnet usage</div>
+        <div className="stat-value">{subnet ? pct + '%' : '-'}</div>
+        <div className={'bar ' + level} role="progressbar" aria-label="Subnet usage"
+          aria-valuenow={pct} aria-valuemin="0" aria-valuemax="100">
+          <i style={{ width: pct + '%' }} />
+        </div>
+        <div className="stat-sub">
+          {subnet ? `${subnet.usedCount} of ${subnet.usable} used in ${subnet.cidr}` : 'Pick a subnet below'}
+        </div>
+      </div>
+
+      <div className="stat">
+        <div className="stat-label">Static / DHCP</div>
+        <div className="stat-value">{staticCount} <span className="slash">/</span> {dhcpCount}</div>
+        <div className="stat-sub">fixed vs automatic</div>
+      </div>
+
+      <div className="stat">
+        <div className="stat-label">Next free address</div>
+        {subnet && subnet.nextFree
+          ? <button type="button" className="stat-link mono" onClick={() => onUse(subnet.nextFree)}>{subnet.nextFree}</button>
+          : <div className="stat-value">-</div>}
+        <div className="stat-sub">tap it to assign</div>
+      </div>
+    </section>
+  )
+}
