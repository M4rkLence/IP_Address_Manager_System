+
+/* ---------- app shell: sidebar + main ---------- */
+.shell { display: grid; grid-template-columns: 252px minmax(0, 1fr); min-height: 100vh; }
+.sidebar { position: sticky; top: 0; height: 100vh; overflow-y: auto; display: flex; flex-direction: column; padding: 24px 0 20px;
+  background: var(--side); border-right: 1px solid var(--line); z-index: 40; }
+.sb-brand { display: flex; align-items: center; gap: 12px; padding: 0 22px 18px; font-size: 1.12rem; font-weight: 800; letter-spacing: -.01em; }
+.sb-section { display: flex; align-items: center; gap: 10px; margin-top: 6px; padding: 14px 22px 8px; border-top: 1px solid var(--line);
+  color: var(--brand); font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
+.sb-profile { display: flex; align-items: center; gap: 10px; padding: 4px 22px 12px; }
+.sb-profile b { display: block; font-size: .88rem; line-height: 1.2; }
+.sb-profile span:not(.avatar) { font-size: .76rem; color: var(--mute); }
+.sb-item { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 8px; width: 100%; height: 38px;
+  padding: 0 20px 0 46px; font-size: .84rem; color: var(--ink); background: none; border: 0; text-align: left; cursor: pointer; }
+.sb-item:hover { background: var(--surface2); }
+.sb-item.on { background: linear-gradient(90deg, rgba(139, 92, 246, .5), rgba(139, 92, 246, .14)); font-weight: 700; }
+.sb-item.on::before { content: ""; position: absolute; left: 0; top: 0; border-style: solid; border-width: 19px 0 19px 13px; border-color: transparent transparent transparent var(--brand); }
+.sb-report { margin: auto 18px 0; padding: 16px 4px 0; border-top: 1px solid var(--line); display: grid; gap: 4px; }
+.sb-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: .8rem; }
+.sb-muted { font-size: .74rem; color: var(--mute); }
+.pill { padding: 1px 8px; border-radius: 6px; font-size: .62rem; font-weight: 800; letter-spacing: .06em; background: color-mix(in srgb, var(--pink) 24%, transparent); color: var(--pink); }
+.btn.block { width: 100%; justify-content: space-between; margin-top: 8px; }
+.sb-overlay { position: fixed; inset: 0; z-index: 39; background: rgba(5, 7, 20, .6); }
+
+.main { min-width: 0; padding: 22px 28px 64px; display: flex; flex-direction: column; gap: 18px; width: 100%; max-width: 1400px; margin: 0; }
+.topbar { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
+.topbar-title { flex: 1; min-width: 220px; }
+.topbar-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
