diff --git a/client/src/components/SubnetGrid.jsx b/client/src/components/SubnetGrid.jsx
new file mode 100644
index 0000000..79feb86
--- /dev/null
+++ b/client/src/components/SubnetGrid.jsx
@@ -0,0 +1,24 @@
+import { formatIp } from '../ip.js'
+
+export default function SubnetGrid({ subnet, onPick }) {
+  const names = new Map(subnet.used.map((u) => [u.ip, u.name]))
+  const cells = []
+  for (let n = subnet.firstNum; n <= subnet.lastNum; n++) {
+    const ip = formatIp(n)
+    const name = names.get(ip)
+    cells.push(
+      <button
+        key={n}
+        type="button"
+        className={'cell ' + (name ? 'used' : 'free')}
+        title={name ? `${ip} - ${name}` : `${ip} - free`}
+        aria-label={name ? `${ip} used by ${name}` : `${ip} free, tap to use`}
+        disabled={Boolean(name)}
+        onClick={() => onPick(ip)}
+      >
+        {n & 255}
+      </button>
+    )
+  }
+  return <div className="cells">{cells}</div>
+}
