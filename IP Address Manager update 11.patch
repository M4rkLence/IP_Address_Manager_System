Subject: [PATCH] IP Address Manager update 11

---
 client/src/App.jsx                    | 21 ++++++++++++++++++-
 client/src/components/DeviceTable.jsx | 29 +++++++++++++++++++++++++++
 2 files changed, 49 insertions(+), 1 deletion(-)
 create mode 100644 client/src/components/DeviceTable.jsx

diff --git a/client/src/App.jsx b/client/src/App.jsx
index 534998d..36173a8 100644
--- a/client/src/App.jsx
+++ b/client/src/App.jsx
@@ -1,3 +1,22 @@
+import { useEffect, useState } from 'react'
+import { api } from './api.js'
+import DeviceTable from './components/DeviceTable.jsx'
+
 export default function App() {
-  return <h1>IP address manager</h1>
+  const [devices, setDevices] = useState([])
+  const [loadError, setLoadError] = useState('')
+
+  useEffect(() => {
+    api.listDevices().then(setDevices)
+      .catch(() => setLoadError('Cannot reach the server. Is it running on port 3001?'))
+  }, [])
+
+  return (
+    <main>
+      <h1>IP address manager</h1>
+      {loadError && <p className="error" role="alert">{loadError}</p>}
+      <h2>All devices</h2>
+      <DeviceTable devices={devices} onEdit={() => {}} onDelete={() => {}} />
+    </main>
+  )
 }
diff --git a/client/src/components/DeviceTable.jsx b/client/src/components/DeviceTable.jsx
new file mode 100644
index 0000000..40bd2b4
--- /dev/null
+++ b/client/src/components/DeviceTable.jsx
@@ -0,0 +1,29 @@
+export default function DeviceTable({ devices, onEdit, onDelete }) {
+  if (!devices.length) {
+    return <p className="empty">No devices yet. Add your first device above.</p>
+  }
+  return (
+    <div className="scroll">
+      <table>
+        <thead>
+          <tr><th>IP address</th><th>Name</th><th>Type</th><th>Assignment</th><th>Notes</th><th></th></tr>
+        </thead>
+        <tbody>
+          {devices.map((d) => (
+            <tr key={d.id}>
+              <td className="mono">{d.ip}</td>
+              <td>{d.name}</td>
+              <td>{d.type}</td>
+              <td>{d.status === 'dhcp' ? 'DHCP' : 'Static'}</td>
+              <td>{d.notes}</td>
+              <td className="rowbtns">
+                <button type="button" onClick={() => onEdit(d)}>Edit</button>
+                <button type="button" onClick={() => onDelete(d)}>Delete</button>
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </div>
+  )
+}
