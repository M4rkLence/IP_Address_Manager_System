 server/index.js | 30 +++++++++++++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/server/index.js b/server/index.js
index 699c327..0c34c8c 100644
--- a/server/index.js
+++ b/server/index.js
@@ -1,5 +1,5 @@
 import http from 'node:http'
-import { formatIp } from './ip.js'
+import { formatIp, parseCidr } from './ip.js'
 import { validateDevice } from './validate.js'
 import {
   listDevices, getDevice, findByIp, devicesInRange,
@@ -7,6 +7,7 @@ import {
 } from './db.js'
 
 const PORT = process.env.PORT || 3001
+const MAX_GRID = 1024 // largest subnet we draw (a /22)
 
 function send(res, status, data) {
   res.writeHead(status, { 'Content-Type': 'application/json' })
@@ -40,6 +41,28 @@ function conflict(ip, ownId) {
   return { error: `${other.ip} is already used by ${other.name}.`, suggestion: suggestFree(ip) }
 }
 
+function subnetInfo(cidrText) {
+  const c = parseCidr(cidrText)
+  if (!c) return { status: 400, body: { error: 'Subnet must look like 192.168.1.0/24.' } }
+  if (c.total > MAX_GRID) return { status: 400, body: { error: 'Subnet too large to display. Use /22 or smaller.' } }
+  const used = devicesInRange(c.first, c.last).map((d) => ({ id: d.id, ip: d.ip, name: d.name }))
+  const usedSet = new Set(used.map((u) => u.ip))
+  let nextFree = null
+  for (let n = c.first; n <= c.last; n++) {
+    if (!usedSet.has(formatIp(n))) { nextFree = formatIp(n); break }
+  }
+  return {
+    status: 200,
+    body: {
+      cidr: `${formatIp(c.network)}/${c.prefix}`,
+      network: formatIp(c.network), broadcast: formatIp(c.broadcast),
+      first: formatIp(c.first), last: formatIp(c.last),
+      firstNum: c.first, lastNum: c.last,
+      usable: c.usable, usedCount: used.length, used, nextFree,
+    },
+  }
+}
+
 const server = http.createServer(async (req, res) => {
   try {
     const url = new URL(req.url, 'http://localhost')
@@ -72,6 +95,11 @@ const server = http.createServer(async (req, res) => {
       if (method === 'DELETE') { deleteDevice(id); return send(res, 204, null) }
     }
 
+    if (path === '/api/subnet' && method === 'GET') {
+      const r = subnetInfo(url.searchParams.get('cidr') || '')
+      return send(res, r.status, r.body)
+    }
+
     send(res, 404, { error: 'Not found.' })
   } catch (e) {
     send(res, 400, { error: e.message || 'Bad request.' })
