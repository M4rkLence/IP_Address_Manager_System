diff --git a/client/src/components/Sidebar.jsx b/client/src/components/Sidebar.jsx
new file mode 100644
index 0000000..5f4003f
--- /dev/null
+++ b/client/src/components/Sidebar.jsx
@@ -0,0 +1,38 @@
+import Icon from './Icon.jsx'
+
+function Section({ icon, title }) {
+  return <div className="sb-section"><Icon name={icon} size={16} /><span>{title}</span></div>
+}
+
+const NAV = [['overview', 'Dashboard'], ['subnet', 'Subnet map'], ['devices', 'Devices']]
+
+export default function Sidebar({ user, deviceCount, active, onNav, onDownload, open, onClose }) {
+  return (
+    <>
+      {open && <div className="sb-overlay" onClick={onClose} />}
+      <aside className={'sidebar' + (open ? ' open' : '')} aria-label="Main navigation">
+        <div className="sb-brand"><span className="logo"><Icon name="network" size={20} /></span>IP Manager</div>
+
+        <Section icon="user" title="Profile" />
+        <div className="sb-profile">
+          <span className="avatar">{user.username[0].toUpperCase()}</span>
+          <div><b>{user.username}</b><span>{deviceCount} {deviceCount === 1 ? 'device' : 'devices'}</span></div>
+        </div>
+
+        <Section icon="chart" title="Overview" />
+        {NAV.map(([id, label]) => (
+          <button key={id} type="button" className={'sb-item' + (active === id ? ' on' : '')}
+            aria-current={active === id ? 'page' : undefined} onClick={() => onNav(id)}>{label}</button>
+        ))}
+
+        <div className="sb-report">
+          <div className="sb-row"><b>Full device report</b><span className="pill">CSV</span></div>
+          <span className="sb-muted">Download report</span>
+          <button type="button" className="btn primary block" onClick={onDownload}>
+            <span>Download</span><Icon name="download" size={16} />
+          </button>
+        </div>
+      </aside>
+    </>
+  )
+}
