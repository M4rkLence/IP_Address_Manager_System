diff --git a/client/src/components/NetworkPanel.jsx b/client/src/components/NetworkPanel.jsx
new file mode 100644
index 0000000..633ef89
--- /dev/null
+++ b/client/src/components/NetworkPanel.jsx
@@ -0,0 +1,61 @@
+import { useEffect, useMemo, useRef } from 'react'
+import Icon from './Icon.jsx'
+import Explorer from './Explorer.jsx'
+import RecordTable from './RecordTable.jsx'
+import { downloadCsv } from '../lib/csv.js'
+
+// The Network card: one search box, then either the big-button explorer or, while searching or filtering, a results table.
+export default function NetworkPanel({ devices, query, onQuery, typeFilter, statusFilter, onClearFilter, onEdit, onDelete, ...explorer }) {
+  const searchRef = useRef(null)
+
+  // Press "/" anywhere to jump to the search box.
+  useEffect(() => {
+    const onKey = (e) => {
+      if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) {
+        e.preventDefault()
+        if (searchRef.current) searchRef.current.focus()
+      }
+    }
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [])
+
+  const q = query.trim().toLowerCase()
+  const filtering = q !== '' || typeFilter !== 'All' || statusFilter !== 'All'
+
+  const rows = useMemo(() => devices.filter((d) =>
+    (typeFilter === 'All' || d.type === typeFilter) && (statusFilter === 'All' || d.status === statusFilter) &&
+    (!q || [d.departmentName, d.routerName, d.ether, d.cidr, d.name, d.type, d.status, d.notes].some((v) => String(v).toLowerCase().includes(q)))
+  ), [devices, q, typeFilter, statusFilter])
+
+  return (
+    <>
+      <div className="toolbar">
+        <label className="search">
+          <Icon name="search" size={16} />
+          <input ref={searchRef} value={query} onChange={(e) => onQuery(e.target.value)}
+            placeholder="Search IP addresses  ( / )" aria-label="Search IP addresses" />
+        </label>
+        {typeFilter !== 'All' && (
+          <button type="button" className="fchip" onClick={() => onClearFilter('type')} aria-label={`Remove type filter ${typeFilter}`}>
+            Type: {typeFilter} <Icon name="x" size={14} />
+          </button>
+        )}
+        {statusFilter !== 'All' && (
+          <button type="button" className="fchip" onClick={() => onClearFilter('status')} aria-label={`Remove assignment filter ${statusFilter}`}>
+            Assignment: {statusFilter === 'dhcp' ? 'DHCP' : 'Static'} <Icon name="x" size={14} />
+          </button>
+        )}
+        {filtering && <span className="count">{rows.length} of {devices.length}</span>}
+        <button type="button" className="btn" disabled={!(filtering ? rows : devices).length} aria-label="Export CSV"
+          onClick={() => downloadCsv(filtering ? rows : devices, filtering ? 'devices.csv' : 'ip-device-report.csv')}>
+          <Icon name="download" size={16} /><span className="btn-text">Export CSV</span>
+        </button>
+      </div>
+
+      {filtering
+        ? <RecordTable rows={rows} onEdit={onEdit} onDelete={onDelete} />
+        : <Explorer devices={devices} onEdit={onEdit} onDelete={onDelete} {...explorer} />}
+    </>
+  )
+}
diff --git a/client/src/components/RecordTable.jsx b/client/src/components/RecordTable.jsx
new file mode 100644
index 0000000..a9d2c1c
--- /dev/null
+++ b/client/src/components/RecordTable.jsx
@@ -0,0 +1,62 @@
+import { useMemo, useState } from 'react'
+import Icon from './Icon.jsx'
+import { typeColor } from '../lib/stats.js'
+
+const TYPE_ICONS = { Router: 'router', Switch: 'switch', Server: 'server', PC: 'pc', Printer: 'printer', Phone: 'phone', Other: 'other' }
+const COLUMNS = [['departmentName', 'Department'], ['routerName', 'Router'], ['ether', 'Ethernet port'], ['ipNum', 'IP address / prefix'],
+  ['name', 'Device'], ['type', 'Type'], ['status', 'Assignment'], ['notes', 'Notes']]
+
+// Search and filter results: every matching IP address in one sortable table.
+export default function RecordTable({ rows, onEdit, onDelete }) {
+  const [sort, setSort] = useState({ key: 'ipNum', dir: 1 })
+
+  const sorted = useMemo(() => [...rows].sort((a, b) => {
+    const x = a[sort.key], y = b[sort.key]
+    return (typeof x === 'number' ? x - y : String(x).localeCompare(String(y), undefined, { numeric: true })) * sort.dir
+  }), [rows, sort])
+
+  const toggleSort = (key) => setSort((s) => ({ key, dir: s.key === key ? -s.dir : 1 }))
+
+  if (!rows.length) return <p className="empty">No IP addresses match your search or filters.</p>
+
+  return (
+    <div className="scroll">
+      <table>
+        <thead>
+          <tr>
+            {COLUMNS.map(([key, label]) => (
+              <th key={key} aria-sort={sort.key === key ? (sort.dir === 1 ? 'ascending' : 'descending') : 'none'}>
+                <button type="button" className="sortbtn" onClick={() => toggleSort(key)}>
+                  {label}{sort.key === key && <Icon name={sort.dir === 1 ? 'up' : 'down'} size={14} />}
+                </button>
+              </th>
+            ))}
+            <th><span className="sr">Actions</span></th>
+          </tr>
+        </thead>
+        <tbody>
+          {sorted.map((d) => (
+            <tr key={d.id}>
+              <td data-label="Department">{d.departmentName}</td>
+              <td data-label="Router">{d.routerName}</td>
+              <td data-label="Ethernet port">{d.ether}</td>
+              <td data-label="IP address / prefix" className="mono"><b>{d.cidr}</b></td>
+              <td data-label="Device"><b>{d.name}</b></td>
+              <td data-label="Type">
+                <span className="typecell"><span className="typeico" style={{ '--c': typeColor(d.type) }}><Icon name={TYPE_ICONS[d.type] || 'other'} size={15} /></span>{d.type}</span>
+              </td>
+              <td data-label="Assignment"><span className={'badge ' + d.status}>{d.status === 'dhcp' ? 'DHCP' : 'Static'}</span></td>
+              <td data-label="Notes">{d.notes || <span className="dim">-</span>}</td>
+              <td className="rowbtns">
+                <div className="rowbtn-wrap">
+                  <button type="button" className="iconbtn" onClick={() => onEdit(d)} aria-label={`Edit ${d.name}`} title="Edit"><Icon name="edit" size={16} /></button>
+                  <button type="button" className="iconbtn danger" onClick={() => onDelete(d)} aria-label={`Delete ${d.name}`} title="Delete"><Icon name="trash" size={16} /></button>
+                </div>
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </div>
+  )
+}
