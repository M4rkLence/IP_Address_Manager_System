Subject: [PATCH] IP Address Manager update 6

---
 server/index.js | 35 +++++++++++++++++++++++++++++------
 1 file changed, 29 insertions(+), 6 deletions(-)

diff --git a/server/index.js b/server/index.js
index 550fb59..75e0ded 100644
--- a/server/index.js
+++ b/server/index.js
@@ -1,5 +1,6 @@
 import http from 'node:http'
-import { listDevices, TYPES } from './db.js'
+import { validateDevice } from './validate.js'
+import { listDevices, createDevice, TYPES } from './db.js'
 
 const PORT = process.env.PORT || 3001
 
@@ -8,11 +9,33 @@ function send(res, status, data) {
   res.end(data === null ? '' : JSON.stringify(data))
 }
 
-const server = http.createServer((req, res) => {
-  const path = new URL(req.url, 'http://localhost').pathname
-  if (path === '/api/types' && req.method === 'GET') return send(res, 200, TYPES)
-  if (path === '/api/devices' && req.method === 'GET') return send(res, 200, listDevices())
-  send(res, 404, { error: 'Not found.' })
+function readJson(req) {
+  return new Promise((resolve, reject) => {
+    let raw = ''
+    req.on('data', (c) => {
+      raw += c
+      if (raw.length > 10_000) { reject(new Error('Request body too large.')); req.destroy() }
+    })
+    req.on('end', () => {
+      try { resolve(raw ? JSON.parse(raw) : {}) } catch { reject(new Error('Body must be valid JSON.')) }
+    })
+  })
+}
+
+const server = http.createServer(async (req, res) => {
+  try {
+    const path = new URL(req.url, 'http://localhost').pathname
+    if (path === '/api/types' && req.method === 'GET') return send(res, 200, TYPES)
+    if (path === '/api/devices' && req.method === 'GET') return send(res, 200, listDevices())
+    if (path === '/api/devices' && req.method === 'POST') {
+      const { error, value } = validateDevice(await readJson(req))
+      if (error) return send(res, 400, { error })
+      return send(res, 201, createDevice(value))
+    }
+    send(res, 404, { error: 'Not found.' })
+  } catch (e) {
+    send(res, 400, { error: e.message || 'Bad request.' })
+  }
 })
 
 server.listen(PORT, () => console.log(`IP manager API running on http://localhost:${PORT}`))
