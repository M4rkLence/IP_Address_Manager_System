diff --git a/server/db.js b/server/db.js
index 5221d99..9e80f5c 100644
--- a/server/db.js
+++ b/server/db.js
@@ -66,6 +66,38 @@ db.exec(`
   )
 `)
 
+// ---------- departments and routers ----------
+db.exec(`
+  CREATE TABLE IF NOT EXISTS departments (
+    id      INTEGER PRIMARY KEY AUTOINCREMENT,
+    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+    name    TEXT    NOT NULL COLLATE NOCASE,
+    UNIQUE (user_id, name)
+  );
+  CREATE TABLE IF NOT EXISTS routers (
+    id            INTEGER PRIMARY KEY AUTOINCREMENT,
+    user_id       INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+    department_id INTEGER NOT NULL REFERENCES departments(id) ON DELETE CASCADE,
+    name          TEXT    NOT NULL COLLATE NOCASE,
+    UNIQUE (department_id, name)
+  );
+`)
+
+// An IP address now belongs to a router and records the Ethernet port and the prefix it uses.
+const deviceCols = db.prepare('PRAGMA table_info(devices)').all().map((c) => c.name)
+if (!deviceCols.includes('router_id')) db.exec('ALTER TABLE devices ADD COLUMN router_id INTEGER REFERENCES routers(id) ON DELETE CASCADE')
+if (!deviceCols.includes('ether')) db.exec("ALTER TABLE devices ADD COLUMN ether TEXT NOT NULL DEFAULT ''")
+if (!deviceCols.includes('prefix')) db.exec('ALTER TABLE devices ADD COLUMN prefix INTEGER NOT NULL DEFAULT 24')
+
+// Addresses saved by older versions have no router yet: park them under "Unassigned".
+for (const { user_id } of db.prepare('SELECT DISTINCT user_id FROM devices WHERE router_id IS NULL').all()) {
+  db.prepare('INSERT OR IGNORE INTO departments (user_id, name) VALUES (?, ?)').run(user_id, 'Unassigned')
+  const dep = db.prepare('SELECT id FROM departments WHERE user_id = ? AND name = ?').get(user_id, 'Unassigned')
+  db.prepare('INSERT OR IGNORE INTO routers (user_id, department_id, name) VALUES (?, ?, ?)').run(user_id, dep.id, 'Unassigned')
+  const rt = db.prepare('SELECT id FROM routers WHERE department_id = ? AND name = ?').get(dep.id, 'Unassigned')
+  db.prepare("UPDATE devices SET router_id = ?, ether = 'Not set' WHERE user_id = ? AND router_id IS NULL").run(rt.id, user_id)
+}
+
 export const TYPES = ['Router', 'Switch', 'Server', 'PC', 'Printer', 'Phone', 'Other']
 export const STATUSES = ['static', 'dhcp']
 
@@ -107,3 +139,78 @@ export function updateDevice(id, userId, d) {
 
 export const deleteDevice = (id, userId) =>
   db.prepare('DELETE FROM devices WHERE id = ? AND user_id = ?').run(id, userId).changes > 0
+
+// ---------- departments ----------
+const toDepartment = (r) => ({ id: Number(r.id), name: r.name, routerCount: Number(r.router_count), ipCount: Number(r.ip_count) })
+
+const DEPARTMENTS = `
+  SELECT d.id, d.name,
+    (SELECT COUNT(*) FROM routers r WHERE r.department_id = d.id) AS router_count,
+    (SELECT COUNT(*) FROM devices v JOIN routers r ON r.id = v.router_id WHERE r.department_id = d.id) AS ip_count
+  FROM departments d`
+
+export const listDepartments = (userId) =>
+  db.prepare(DEPARTMENTS + ' WHERE d.user_id = ? ORDER BY d.name').all(userId).map(toDepartment)
+
+export const getDepartment = (id, userId) => {
+  const r = db.prepare(DEPARTMENTS + ' WHERE d.id = ? AND d.user_id = ?').get(id, userId)
+  return r ? toDepartment(r) : null
+}
+
+export const findDepartmentByName = (userId, name) => {
+  const r = db.prepare('SELECT id FROM departments WHERE user_id = ? AND name = ?').get(userId, name)
+  return r ? getDepartment(Number(r.id), userId) : null
+}
+
+export function createDepartment(userId, name) {
+  const r = db.prepare('INSERT INTO departments (user_id, name) VALUES (?, ?)').run(userId, name)
+  return getDepartment(Number(r.lastInsertRowid), userId)
+}
+
+export function renameDepartment(id, userId, name) {
+  db.prepare('UPDATE departments SET name = ? WHERE id = ? AND user_id = ?').run(name, id, userId)
+  return getDepartment(id, userId)
+}
+
+// Deleting a department also deletes its routers and their IP addresses.
+export const deleteDepartment = (id, userId) =>
+  db.prepare('DELETE FROM departments WHERE id = ? AND user_id = ?').run(id, userId).changes > 0
+
+// ---------- routers ----------
+const toRouter = (r) => ({
+  id: Number(r.id), name: r.name, departmentId: Number(r.department_id), departmentName: r.department_name,
+  ipCount: Number(r.ip_count), etherCount: Number(r.ether_count),
+})
+
+const ROUTERS = `
+  SELECT r.id, r.name, r.department_id, d.name AS department_name,
+    (SELECT COUNT(*) FROM devices v WHERE v.router_id = r.id) AS ip_count,
+    (SELECT COUNT(DISTINCT lower(v.ether)) FROM devices v WHERE v.router_id = r.id) AS ether_count
+  FROM routers r JOIN departments d ON d.id = r.department_id`
+
+export const listRouters = (userId) =>
+  db.prepare(ROUTERS + ' WHERE r.user_id = ? ORDER BY d.name, r.name').all(userId).map(toRouter)
+
+export const getRouter = (id, userId) => {
+  const r = db.prepare(ROUTERS + ' WHERE r.id = ? AND r.user_id = ?').get(id, userId)
+  return r ? toRouter(r) : null
+}
+
+export const findRouterByName = (departmentId, name) => {
+  const r = db.prepare('SELECT id, user_id FROM routers WHERE department_id = ? AND name = ?').get(departmentId, name)
+  return r ? getRouter(Number(r.id), Number(r.user_id)) : null
+}
+
+export function createRouter(userId, departmentId, name) {
+  const r = db.prepare('INSERT INTO routers (user_id, department_id, name) VALUES (?, ?, ?)').run(userId, departmentId, name)
+  return getRouter(Number(r.lastInsertRowid), userId)
+}
+
+export function renameRouter(id, userId, name) {
+  db.prepare('UPDATE routers SET name = ? WHERE id = ? AND user_id = ?').run(name, id, userId)
+  return getRouter(id, userId)
+}
+
+// Deleting a router also deletes its IP addresses.
+export const deleteRouter = (id, userId) =>
+  db.prepare('DELETE FROM routers WHERE id = ? AND user_id = ?').run(id, userId).changes > 0
