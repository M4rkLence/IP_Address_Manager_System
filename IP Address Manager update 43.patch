   createdAt: r.created_at, // UTC, like "2026-11-12 08:30:00"
 })
 
-// Every query below filters by user_id, so people only ever see their own devices.
+// An IP address together with the router and the department it belongs to.
+const DEVICES = `
+  SELECT d.*, r.name AS router_name, r.department_id AS department_id, dep.name AS department_name
+  FROM devices d
+  LEFT JOIN routers r ON r.id = d.router_id
+  LEFT JOIN departments dep ON dep.id = r.department_id`
+
+// Every query below filters by user_id, so people only ever see their own addresses.
 export const listDevices = (userId) =>
-  db.prepare('SELECT * FROM devices WHERE user_id = ? ORDER BY ip').all(userId).map(toDevice)
+  db.prepare(DEVICES + ' WHERE d.user_id = ? ORDER BY d.ip').all(userId).map(toDevice)
 
 export const getDevice = (id, userId) => {
-  const r = db.prepare('SELECT * FROM devices WHERE id = ? AND user_id = ?').get(id, userId)
+  const r = db.prepare(DEVICES + ' WHERE d.id = ? AND d.user_id = ?').get(id, userId)
   return r ? toDevice(r) : null
 }
 
 export const findByIp = (userId, ip) => {
-  const r = db.prepare('SELECT * FROM devices WHERE user_id = ? AND ip = ?').get(userId, ip)
+  const r = db.prepare(DEVICES + ' WHERE d.user_id = ? AND d.ip = ?').get(userId, ip)
   return r ? toDevice(r) : null
 }
 
 export const devicesInRange = (userId, from, to) =>
-  db.prepare('SELECT * FROM devices WHERE user_id = ? AND ip BETWEEN ? AND ? ORDER BY ip')
+  db.prepare(DEVICES + ' WHERE d.user_id = ? AND d.ip BETWEEN ? AND ? ORDER BY d.ip')
     .all(userId, from, to).map(toDevice)
 
 export function createDevice(userId, d) {
-  const r = db.prepare('INSERT INTO devices (user_id, ip, name, type, status, notes) VALUES (?, ?, ?, ?, ?, ?)')
-    .run(userId, d.ip, d.name, d.type, d.status, d.notes)
+  const r = db.prepare('INSERT INTO devices (user_id, router_id, ether, ip, prefix, name, type, status, notes) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)')
+    .run(userId, d.routerId, d.ether, d.ip, d.prefix, d.name, d.type, d.status, d.notes)
   return getDevice(Number(r.lastInsertRowid), userId)
 }
 
 export function updateDevice(id, userId, d) {
-  db.prepare('UPDATE devices SET ip = ?, name = ?, type = ?, status = ?, notes = ? WHERE id = ? AND user_id = ?')
-    .run(d.ip, d.name, d.type, d.status, d.notes, id, userId)
+  db.prepare('UPDATE devices SET router_id = ?, ether = ?, ip = ?, prefix = ?, name = ?, type = ?, status = ?, notes = ? WHERE id = ? AND user_id = ?')
+    .run(d.routerId, d.ether, d.ip, d.prefix, d.name, d.type, d.status, d.notes, id, userId)
   return getDevice(id, userId)
 }
 
