index 0000000..638fb99
--- /dev/null
+++ b/client/src/components/DeviceList.jsx
@@ -0,0 +1,131 @@
+import { useEffect, useMemo, useRef, useState } from 'react'
+import Icon from './Icon.jsx'
+
+const TYPE_ICONS = { Router: 'router', Switch: 'switch', Server: 'server', PC: 'pc', Printer: 'printer', Phone: 'phone', Other: 'other' }
+const COLUMNS = [['ipNum', 'IP address'], ['name', 'Name'], ['type', 'Type'], ['status', 'Assignment'], ['notes', 'Notes']]
+
+function toCsv(rows) {
+  const q = (v) => `"${String(v).replace(/"/g, '""')}"`
+  const lines = rows.map((d) => [d.ip, d.name, d.type, d.status, d.notes].map(q).join(','))
+  return ['IP address,Name,Type,Assignment,Notes', ...lines].join('\n')
+}
+
+export default function DeviceList({ devices, onAdd, onEdit, onDelete }) {
+  const [query, setQuery] = useState('')
+  const [type, setType] = useState('All')
+  const [sort, setSort] = useState({ key: 'ipNum', dir: 1 })
+  const searchRef = useRef(null)
+
+  // Press "/" anywhere to jump to the search box.
+  useEffect(() => {
+    const onKey = (e) => {
+      if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) {
+        e.preventDefault()
+        if (searchRef.current) searchRef.current.focus()
+      }
+    }
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [])
+
+  const types = useMemo(() => ['All', ...new Set(devices.map((d) => d.type))], [devices])
+  const activeType = types.includes(type) ? type : 'All'
+
+  const rows = useMemo(() => {
+    const q = query.trim().toLowerCase()
+    return devices
+      .filter((d) => (activeType === 'All' || d.type === activeType) &&
+        (!q || [d.ip, d.name, d.type, d.status, d.notes].some((v) => String(v).toLowerCase().includes(q))))
+      .sort((a, b) => {
+        const x = a[sort.key], y = b[sort.key]
+        return (typeof x === 'number' ? x - y : String(x).localeCompare(String(y))) * sort.dir
+      })
+  }, [devices, query, activeType, sort])
+
+  const toggleSort = (key) => setSort((s) => ({ key, dir: s.key === key ? -s.dir : 1 }))
+
+  function exportCsv() {
+    const url = URL.createObjectURL(new Blob([toCsv(rows)], { type: 'text/csv' }))
+    const a = document.createElement('a')
+    a.href = url
+    a.download = 'devices.csv'
+    a.click()
+    URL.revokeObjectURL(url)
+  }
+
+  if (!devices.length) {
+    return (
+      <div className="empty-state">
+        <Icon name="network" size={36} />
+        <h3>No devices yet</h3>
+        <p>Add your first device to start tracking IP addresses.</p>
+        <button type="button" className="btn primary" onClick={onAdd}><Icon name="plus" size={16} /> Add device</button>
+      </div>
+    )
+  }
+
+  return (
+    <>
+      <div className="toolbar">
+        <label className="search">
+          <Icon name="search" size={16} />
+          <input ref={searchRef} value={query} onChange={(e) => setQuery(e.target.value)}
+            placeholder="Search devices  ( / )" aria-label="Search devices" />
+        </label>
+        <select value={activeType} onChange={(e) => setType(e.target.value)} aria-label="Filter by type">
+          {types.map((t) => <option key={t} value={t}>{t === 'All' ? 'All types' : t}</option>)}
+        </select>
+        <span className="count">{rows.length} of {devices.length}</span>
+        <button type="button" className="btn" onClick={exportCsv} disabled={!rows.length} aria-label="Export CSV">
+          <Icon name="download" size={16} /><span className="btn-text">Export CSV</span>
+        </button>
+      </div>
+
+      {rows.length ? (
+        <div className="scroll">
+          <table>
+            <thead>
+              <tr>
+                {COLUMNS.map(([key, label]) => (
+                  <th key={key} aria-sort={sort.key === key ? (sort.dir === 1 ? 'ascending' : 'descending') : 'none'}>
+                    <button type="button" className="sortbtn" onClick={() => toggleSort(key)}>
+                      {label}{sort.key === key && <Icon name={sort.dir === 1 ? 'up' : 'down'} size={14} />}
+                    </button>
+                  </th>
+                ))}
+                <th><span className="sr">Actions</span></th>
+              </tr>
+            </thead>
+            <tbody>
+              {rows.map((d) => (
+                <tr key={d.id}>
+                  <td data-label="IP address" className="mono">{d.ip}</td>
+                  <td data-label="Name"><b>{d.name}</b></td>
+                  <td data-label="Type">
+                    <span className="typecell"><Icon name={TYPE_ICONS[d.type] || 'other'} size={16} />{d.type}</span>
+                  </td>
+                  <td data-label="Assignment">
+                    <span className={'badge ' + d.status}>{d.status === 'dhcp' ? 'DHCP' : 'Static'}</span>
+                  </td>
+                  <td data-label="Notes">{d.notes || <span className="dim">-</span>}</td>
+                  <td className="rowbtns">
+                    <div className="rowbtn-wrap">
+                      <button type="button" className="iconbtn" onClick={() => onEdit(d)} aria-label={`Edit ${d.name}`} title="Edit">
+                        <Icon name="edit" size={16} />
+                      </button>
+                      <button type="button" className="iconbtn danger" onClick={() => onDelete(d)} aria-label={`Delete ${d.name}`} title="Delete">
+                        <Icon name="trash" size={16} />
+                      </button>
+                    </div>
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      ) : (
+        <p className="empty">No devices match your search.</p>
+      )}
+    </>
+  )
+}
