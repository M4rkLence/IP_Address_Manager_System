diff --git a/server/api.test.js b/server/api.test.js
new file mode 100644
index 0000000..7b78f99
--- /dev/null
+++ b/server/api.test.js
@@ -0,0 +1,127 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { spawn } from 'node:child_process'
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { DatabaseSync } from 'node:sqlite'
+
+const here = fileURLToPath(new URL('.', import.meta.url))
+const dir = mkdtempSync(join(tmpdir(), 'ipam-'))
+const PORT = 3950 + Math.floor(Math.random() * 40)
+let server
+
+// a tiny API client that keeps one login cookie per "person"
+function client() {
+  let cookie = ''
+  return async (method, path, body) => {
+    const res = await fetch(`http://localhost:${PORT}/api${path}`, {
+      method, headers: { 'Content-Type': 'application/json', ...(cookie ? { Cookie: cookie } : {}) },
+      body: body === undefined ? undefined : JSON.stringify(body),
+    })
+    const set = res.headers.get('set-cookie')
+    if (set) cookie = set.split(';')[0]
+    const text = await res.text()
+    return { status: res.status, data: text ? JSON.parse(text) : null }
+  }
+}
+
+async function start(dbFile, port) {
+  const p = spawn(process.execPath, ['index.js'], { cwd: here, env: { ...process.env, PORT: String(port), DB_FILE: dbFile }, stdio: 'ignore' })
+  for (let i = 0; i < 60; i++) {
+    try { if ((await fetch(`http://localhost:${port}/api/types`)).ok) return p } catch { /* not up yet */ }
+    await new Promise((r) => setTimeout(r, 100))
+  }
+  throw new Error('server did not start')
+}
+
+test.before(async () => { server = await start(join(dir, 'test.db'), PORT) })
+test.after(() => { server.kill(); rmSync(dir, { recursive: true, force: true }) })
+
+test('departments, routers, Ethernet ports and prefixes', async () => {
+  const alice = client()
+  assert.equal((await alice('POST', '/register', { username: 'alice', password: 'password123' })).status, 201)
+
+  // departments
+  const acc = (await alice('POST', '/departments', { name: 'Accounting' })).data
+  assert.equal(acc.name, 'Accounting')
+  assert.equal((await alice('POST', '/departments', { name: 'accounting' })).status, 409, 'names are not case sensitive')
+  assert.equal((await alice('POST', '/departments', { name: '   ' })).status, 400)
+  const hr = (await alice('POST', '/departments', { name: 'HR' })).data
+
+  // routers
+  const r1 = (await alice('POST', '/routers', { departmentId: acc.id, name: 'R1' })).data
+  assert.equal(r1.departmentName, 'Accounting')
+  assert.equal((await alice('POST', '/routers', { departmentId: acc.id, name: 'r1' })).status, 409)
+  assert.equal((await alice('POST', '/routers', { departmentId: 9999, name: 'R9' })).status, 400)
+  assert.equal((await alice('POST', '/routers', { departmentId: hr.id, name: 'R1' })).status, 201, 'same name is fine in another department')
+
+  // IP addresses
+  const base = { routerId: r1.id, ether: 'Gi0/0', ip: '192.168.10.1', prefix: 24, name: 'Gateway', type: 'Router', status: 'static' }
+  const made = await alice('POST', '/devices', base)
+  assert.equal(made.status, 201)
+  assert.equal(made.data.cidr, '192.168.10.1/24')
+  assert.equal(made.data.departmentName, 'Accounting')
+  assert.equal(made.data.routerName, 'R1')
+  assert.equal(made.data.ether, 'Gi0/0')
+  assert.equal((await alice('POST', '/devices', { ...base, routerId: undefined, ip: '192.168.10.2' })).status, 400, 'router is required')
+  assert.equal((await alice('POST', '/devices', { ...base, ether: ' ', ip: '192.168.10.2' })).status, 400, 'port is required')
+  assert.equal((await alice('POST', '/devices', { ...base, prefix: 33, ip: '192.168.10.2' })).status, 400)
+  assert.equal((await alice('POST', '/devices', { ...base, prefix: '', ip: '192.168.10.2' })).status, 400)
+  assert.equal((await alice('POST', '/devices', { ...base, prefix: '/25', ip: '192.168.10.2', name: 'PC1', type: 'PC' })).data.prefix, 25, '"/25" is accepted')
+  const dup = await alice('POST', '/devices', { ...base, name: 'Other' })
+  assert.equal(dup.status, 409)
+  assert.match(dup.data.error, /Accounting \/ R1 \/ Gi0\/0/)
+  assert.equal(dup.data.suggestion, '192.168.10.3')
+
+  // counts shown on the big buttons
+  const deps = (await alice('GET', '/departments')).data
+  assert.deepEqual(deps.map((d) => [d.name, d.routerCount, d.ipCount]), [['Accounting', 1, 2], ['HR', 1, 0]])
+  const rts = (await alice('GET', '/routers')).data
+  assert.deepEqual(rts.map((r) => [r.departmentName, r.name, r.ipCount, r.etherCount]), [['Accounting', 'R1', 2, 1], ['HR', 'R1', 0, 0]])
+
+  // another person cannot see or use them
+  const bob = client()
+  await bob('POST', '/register', { username: 'bob', password: 'password456' })
+  assert.deepEqual((await bob('GET', '/departments')).data, [])
+  assert.equal((await bob('POST', '/devices', { ...base, ip: '10.0.0.1' })).status, 400, "bob cannot use alice's router")
+  assert.equal((await bob('PUT', `/departments/${acc.id}`, { name: 'Mine' })).status, 404)
+  assert.equal((await bob('DELETE', `/routers/${r1.id}`)).status, 404)
+
+  // rename, edit, move
+  assert.equal((await alice('PUT', `/departments/${hr.id}`, { name: 'Accounting' })).status, 409)
+  assert.equal((await alice('PUT', `/departments/${hr.id}`, { name: 'Human Resources' })).data.name, 'Human Resources')
+  const moved = await alice('PUT', `/devices/${made.data.id}`, { ...base, ether: 'Gi0/1', routerId: rts[1].id })
+  assert.equal(moved.data.departmentName, 'Human Resources')
+  assert.equal(moved.data.ether, 'Gi0/1')
+
+  // deleting a router or a department deletes the addresses inside it
+  assert.equal((await alice('DELETE', `/routers/${rts[1].id}`)).status, 204)
+  assert.equal((await alice('GET', '/devices')).data.length, 1)
+  assert.equal((await alice('DELETE', `/departments/${acc.id}`)).status, 204)
+  assert.equal((await alice('GET', '/devices')).data.length, 0)
+})
+
+test('addresses saved by an older version are moved under "Unassigned"', async () => {
+  const file = join(dir, 'old.db')
+  const old = new DatabaseSync(file)
+  old.exec(`
+    PRAGMA foreign_keys = ON;
+    CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT NOT NULL UNIQUE COLLATE NOCASE, password_hash TEXT NOT NULL, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);
+    CREATE TABLE sessions (token_hash TEXT PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, expires_at INTEGER NOT NULL);
+    CREATE TABLE devices (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, ip INTEGER NOT NULL,
+      name TEXT NOT NULL, type TEXT NOT NULL, status TEXT NOT NULL, notes TEXT NOT NULL DEFAULT '', created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, UNIQUE (user_id, ip));
+    INSERT INTO users (username, password_hash) VALUES ('legacy', 'x:y');
+    INSERT INTO devices (user_id, ip, name, type, status) VALUES (1, 3232235786, 'Old printer', 'Printer', 'static');
+  `)
+  old.close()
+  const p = await start(file, PORT + 50)
+  try {
+    const db = new DatabaseSync(file)
+    const row = db.prepare(`SELECT d.name, d.ether, d.prefix, r.name AS router, dep.name AS dept FROM devices d
+      JOIN routers r ON r.id = d.router_id JOIN departments dep ON dep.id = r.department_id`).get()
+    db.close()
+    assert.deepEqual({ ...row }, { name: 'Old printer', ether: 'Not set', prefix: 24, router: 'Unassigned', dept: 'Unassigned' })
+  } finally { p.kill() }
+})
