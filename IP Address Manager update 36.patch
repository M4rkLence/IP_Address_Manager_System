diff --git a/client/src/components/charts/LineChart.jsx b/client/src/components/charts/LineChart.jsx
new file mode 100644
index 0000000..512b874
--- /dev/null
+++ b/client/src/components/charts/LineChart.jsx
@@ -0,0 +1,90 @@
+import { useState } from 'react'
+
+const W = 640, H = 236
+const PAD = { l: 34, r: 14, t: 14, b: 28 }
+
+// Turns points into a smooth curve (Catmull-Rom converted to Bezier segments).
+function smooth(pts, top, bottom) {
+  const cl = (v) => Math.max(top, Math.min(bottom, v))
+  let d = `M${pts[0][0]},${pts[0][1]}`
+  for (let i = 0; i < pts.length - 1; i++) {
+    const p0 = pts[i - 1] || pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] || p2
+    d += ` C${p1[0] + (p2[0] - p0[0]) / 6},${cl(p1[1] + (p2[1] - p0[1]) / 6)} ${p2[0] - (p3[0] - p1[0]) / 6},${cl(p2[1] - (p3[1] - p1[1]) / 6)} ${p2[0]},${p2[1]}`
+  }
+  return d
+}
+
+const fmt = (d) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
+
+// dates: Date[]  series: [{ key, name, color, values, dashed }]
+export default function LineChart({ dates, series, title }) {
+  const [hover, setHover] = useState(null)
+  const n = dates.length
+  const top = Math.max(4, ...series.flatMap((s) => s.values))
+  const max = Math.ceil(top / 4) * 4
+  const x = (i) => PAD.l + (i / (n - 1)) * (W - PAD.l - PAD.r)
+  const y = (v) => PAD.t + (1 - v / max) * (H - PAD.t - PAD.b)
+  const ticks = [0, 1, 2, 3, 4].map((i) => (max / 4) * i)
+
+  function onMove(e) {
+    const r = e.currentTarget.getBoundingClientRect()
+    const px = ((e.clientX - r.left) / r.width) * W
+    const i = Math.round(((px - PAD.l) / (W - PAD.l - PAD.r)) * (n - 1))
+    setHover(Math.max(0, Math.min(n - 1, i)))
+  }
+
+  return (
+    <div className="linechart">
+      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title} onMouseMove={onMove} onMouseLeave={() => setHover(null)}>
+        <defs>
+          {series.map((s) => (
+            <linearGradient key={s.key} id={'lg-' + s.key} x1="0" x2="0" y1="0" y2="1">
+              <stop offset="0%" stopColor={s.color} stopOpacity=".32" />
+              <stop offset="100%" stopColor={s.color} stopOpacity="0" />
+            </linearGradient>
+          ))}
+        </defs>
+
+        {ticks.map((t) => (
+          <g key={t}>
+            <line x1={PAD.l} x2={W - PAD.r} y1={y(t)} y2={y(t)} className="lc-grid" />
+            <text x={PAD.l - 8} y={y(t) + 3} textAnchor="end" className="lc-tick">{Math.round(t)}</text>
+          </g>
+        ))}
+        {dates.map((d, i) => (i % 2 === 0 ? <line key={i} x1={x(i)} x2={x(i)} y1={PAD.t} y2={H - PAD.b} className="lc-grid faint" /> : null))}
+        {dates.map((d, i) => (i % 3 === 0 || i === n - 1 ? (
+          <text key={i} x={x(i)} y={H - 8} textAnchor="middle" className="lc-tick">{fmt(d)}</text>
+        ) : null))}
+
+        {series.map((s) => {
+          const pts = s.values.map((v, i) => [x(i), y(v)])
+          const line = smooth(pts, PAD.t, H - PAD.b)
+          return (
+            <g key={s.key}>
+              <path d={`${line} L${x(n - 1)},${y(0)} L${x(0)},${y(0)} Z`} fill={`url(#lg-${s.key})`} />
+              <path d={line} fill="none" strokeWidth="2.6" strokeLinecap="round" strokeDasharray={s.dashed ? '1 6' : undefined} style={{ stroke: s.color }} />
+            </g>
+          )
+        })}
+
+        {hover !== null && (
+          <g>
+            <line x1={x(hover)} x2={x(hover)} y1={PAD.t} y2={H - PAD.b} className="lc-cursor" />
+            {series.map((s) => <circle key={s.key} cx={x(hover)} cy={y(s.values[hover])} r="5" className="lc-dot" style={{ stroke: s.color }} />)}
+          </g>
+        )}
+      </svg>
+
+      {hover !== null && (
+        <div className="tip" style={{ left: Math.min(88, Math.max(12, (x(hover) / W) * 100)) + '%' }} role="status">
+          <b>{fmt(dates[hover])}</b>
+          {series.map((s) => <span key={s.key}>{s.name}: {s.values[hover]}</span>)}
+        </div>
+      )}
+
+      <div className="lc-legend">
+        {series.map((s) => <span key={s.key}><i style={{ borderTopColor: s.color, borderTopStyle: s.dashed ? 'dotted' : 'solid' }} />{s.name}</span>)}
+      </div>
+    </div>
+  )
+}
