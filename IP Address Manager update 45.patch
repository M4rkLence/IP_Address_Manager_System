diff --git a/client/src/components/Explorer.jsx b/client/src/components/Explorer.jsx
new file mode 100644
index 0000000..35fde50
--- /dev/null
+++ b/client/src/components/Explorer.jsx
@@ -0,0 +1,132 @@
+import Icon from './Icon.jsx'
+
+const TYPE_ICONS = { Router: 'router', Switch: 'switch', Server: 'server', PC: 'pc', Printer: 'printer', Phone: 'phone', Other: 'other' }
+const natural = (a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' })
+const plural = (n, one, many = one + 's') => `${n} ${n === 1 ? one : many}`
+
+// Departments (big buttons) > Routers (big buttons) > Ethernet ports with their IP address and prefix.
+export default function Explorer({
+  departments, routers, devices, selection, onSelect,
+  onAddDepartment, onRenameDepartment, onDeleteDepartment, onAddRouter, onRenameRouter, onDeleteRouter, onAddIp, onEdit, onDelete,
+}) {
+  const dept = departments.find((d) => d.id === selection.deptId)
+  const router = dept && routers.find((r) => r.id === selection.routerId && r.departmentId === dept.id)
+
+  const crumbs = (
+    <nav className="crumbs" aria-label="Breadcrumb">
+      <button type="button" className={dept ? '' : 'here'} disabled={!dept} onClick={() => onSelect({ deptId: null, routerId: null })}>Departments</button>
+      {dept && (
+        <>
+          <span aria-hidden="true">&rsaquo;</span>
+          <button type="button" className={router ? '' : 'here'} disabled={!router} onClick={() => onSelect({ deptId: dept.id, routerId: null })}>{dept.name}</button>
+        </>
+      )}
+      {router && <><span aria-hidden="true">&rsaquo;</span><span className="here">{router.name}</span></>}
+    </nav>
+  )
+
+  // ---------- level 1: departments ----------
+  if (!dept) {
+    return (
+      <div>
+        {crumbs}
+        {departments.length === 0 && <p className="exp-empty">No departments yet. Add your first department, for example Accounting.</p>}
+        <div className="bigbtns">
+          {departments.map((d) => (
+            <button key={d.id} type="button" className="bigbtn" onClick={() => onSelect({ deptId: d.id, routerId: null })}>
+              <span className="bigico purple"><Icon name="building" size={22} /></span>
+              <strong>{d.name}</strong>
+              <small>{plural(d.routerCount, 'router')} &middot; {plural(d.ipCount, 'IP address', 'IP addresses')}</small>
+            </button>
+          ))}
+          <button type="button" className="bigbtn add" onClick={onAddDepartment}>
+            <Icon name="plus" size={24} /><strong>Add department</strong>
+          </button>
+        </div>
+      </div>
+    )
+  }
+
+  // ---------- level 2: the routers of one department ----------
+  if (!router) {
+    const list = routers.filter((r) => r.departmentId === dept.id)
+    return (
+      <div>
+        {crumbs}
+        <div className="exp-head">
+          <h3>{dept.name}</h3>
+          <div className="exp-actions">
+            <button type="button" className="btn" onClick={() => onRenameDepartment(dept)}><Icon name="edit" size={16} /> Rename</button>
+            <button type="button" className="btn danger" onClick={() => onDeleteDepartment(dept)}><Icon name="trash" size={16} /> Delete department</button>
+          </div>
+        </div>
+        {list.length === 0 && <p className="exp-empty">{dept.name} has no routers yet. Add the first one, for example R1.</p>}
+        <div className="bigbtns">
+          {list.map((r) => (
+            <button key={r.id} type="button" className="bigbtn" onClick={() => onSelect({ deptId: dept.id, routerId: r.id })}>
+              <span className="bigico cyan"><Icon name="router" size={22} /></span>
+              <strong>{r.name}</strong>
+              <small>{plural(r.etherCount, 'Ethernet port')} &middot; {plural(r.ipCount, 'IP address', 'IP addresses')}</small>
+            </button>
+          ))}
+          <button type="button" className="bigbtn add" onClick={() => onAddRouter(dept.id)}>
+            <Icon name="plus" size={24} /><strong>Add router</strong>
+          </button>
+        </div>
+      </div>
+    )
+  }
+
+  // ---------- level 3: the Ethernet ports of one router, each with its IP address / prefix ----------
+  const byPort = new Map()
+  for (const d of devices.filter((x) => x.routerId === router.id)) {
+    const key = d.ether.toLowerCase()
+    if (!byPort.has(key)) byPort.set(key, { ether: d.ether, items: [] })
+    byPort.get(key).items.push(d)
+  }
+  const ports = [...byPort.values()].sort((a, b) => natural(a.ether, b.ether))
+  ports.forEach((p) => p.items.sort((a, b) => a.ipNum - b.ipNum))
+
+  return (
+    <div>
+      {crumbs}
+      <div className="exp-head">
+        <h3>{router.name}</h3>
+        <div className="exp-actions">
+          <button type="button" className="btn primary" onClick={() => onAddIp({ departmentId: dept.id, routerId: router.id })}>
+            <Icon name="plus" size={16} /> Add IP address
+          </button>
+          <button type="button" className="btn" onClick={() => onRenameRouter(router)}><Icon name="edit" size={16} /> Rename</button>
+          <button type="button" className="btn danger" onClick={() => onDeleteRouter(router)}><Icon name="trash" size={16} /> Delete router</button>
+        </div>
+      </div>
+
+      {ports.length === 0 && <p className="exp-empty">{router.name} has no IP addresses yet. Add one with the Add IP address button.</p>}
+
+      {ports.map((p) => (
+        <section key={p.ether} className="port" aria-label={`Ethernet port ${p.ether}`}>
+          <div className="port-head">
+            <span className="port-ico"><Icon name="ethernet" size={18} /></span>
+            <b>{p.ether}</b>
+            <span className="dim">{plural(p.items.length, 'IP address', 'IP addresses')}</span>
+          </div>
+          {p.items.map((d) => (
+            <div className="iprow" key={d.id}>
+              <span className="ipcidr mono">{d.cidr}</span>
+              <span className="ipname">
+                <b>{d.name}</b>
+                <span className="typecell"><Icon name={TYPE_ICONS[d.type] || 'other'} size={14} />{d.type}</span>
+              </span>
+              <span className={'badge ' + d.status}>{d.status === 'dhcp' ? 'DHCP' : 'Static'}</span>
+              <span className="ipnotes dim">{d.notes}</span>
+              <span className="rowbtn-wrap">
+                <button type="button" className="iconbtn" onClick={() => onEdit(d)} aria-label={`Edit ${d.name}`} title="Edit"><Icon name="edit" size={16} /></button>
+                <button type="button" className="iconbtn danger" onClick={() => onDelete(d)} aria-label={`Delete ${d.name}`} title="Delete"><Icon name="trash" size={16} /></button>
+              </span>
+            </div>
+          ))}
+        </section>
+      ))}
+    </div>
+  )
+}
diff --git a/client/src/styles.css b/client/src/styles.css
index 3c4ef45..99a0933 100644
--- a/client/src/styles.css
+++ b/client/src/styles.css
@@ -298,3 +298,41 @@ tbody tr:hover { background: color-mix(in srgb, var(--brand) 6%, transparent); }
 .prefixfield span { padding-left: 14px; color: var(--mute); font-weight: 700; }
 .prefixfield input { margin: 0; border: 0; background: none; outline: 0; box-shadow: none; padding-left: 6px; }
 .prefixfield:focus-within { border-color: var(--cyan); outline: 3px solid color-mix(in srgb, var(--cyan) 25%, transparent); }
+
+/* ---------- Department > Router > Ethernet port ---------- */
+.crumbs { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; font-size: .9rem; color: var(--mute); }
+.crumbs button { background: none; border: 0; padding: 2px 4px; cursor: pointer; color: var(--cyan); font-weight: 600; border-radius: 6px; }
+.crumbs button:hover:not(:disabled) { text-decoration: underline; }
+.crumbs button:disabled, .crumbs .here { color: var(--ink); cursor: default; font-weight: 700; }
+.exp-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
+.exp-head h3 { margin: 0; font-size: 1.35rem; letter-spacing: -.01em; }
+.exp-actions { display: flex; gap: 8px; flex-wrap: wrap; }
+.btn.danger:hover { color: var(--err); border-color: var(--err); }
+.exp-empty { margin: 0 0 16px; padding: 14px 16px; border-radius: 14px; background: var(--surface2); border: 1px dashed var(--line2); color: var(--mute); }
+.bigbtns { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
+.bigbtn { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 8px; min-height: 140px; padding: 20px; text-align: left; cursor: pointer;
+  color: var(--ink); background: var(--surface2); border: 1px solid var(--line2); border-radius: 22px; transition: transform .12s, border-color .15s, box-shadow .15s; }
+.bigbtn:hover { transform: translateY(-3px); border-color: var(--brand); box-shadow: 0 12px 30px color-mix(in srgb, var(--brand) 28%, transparent); }
+.bigbtn strong { font-size: 1.2rem; letter-spacing: -.01em; }
+.bigbtn small { color: var(--mute); font-size: .84rem; }
+.bigbtn.add { align-items: center; border-style: dashed; color: var(--brand); background: transparent; }
+.bigbtn.add:hover { background: var(--brand-soft); }
+.bigico { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 16px; color: #fff; }
+.bigico.purple { background: var(--grad-purple); }
+.bigico.cyan { background: var(--grad-cyan); }
+.port { margin-bottom: 16px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface2); overflow: hidden; }
+.port-head { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--brand) 6%, var(--surface2)); }
+.port-head b { font-size: 1.02rem; }
+.port-ico { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 10px; color: #fff; background: var(--grad-cyan); }
+.iprow { display: grid; grid-template-columns: 200px minmax(0, 1.4fr) auto minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 10px 16px; border-bottom: 1px solid var(--line); }
+.iprow:last-child { border-bottom: 0; }
+.iprow:hover { background: color-mix(in srgb, var(--brand) 5%, transparent); }
+.ipcidr { font-size: 1.02rem; font-weight: 700; }
+.ipname { display: flex; flex-direction: column; min-width: 0; }
+.ipname .typecell { font-size: .8rem; color: var(--mute); }
+.ipnotes { font-size: .86rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+@media (max-width: 900px) {
+  .iprow { grid-template-columns: minmax(0, 1fr) auto; row-gap: 4px; }
+  .ipcidr { grid-column: 1; } .iprow .badge { grid-column: 2; justify-self: end; }
+  .ipname { grid-column: 1 / -1; } .ipnotes { grid-column: 1; } .iprow .rowbtn-wrap { grid-column: 2; justify-self: end; }
+}
