index 0000000..6d6b043
--- /dev/null
+++ b/client/src/components/charts/DonutChart.jsx
@@ -0,0 +1,36 @@
+// A ring chart drawn with SVG circles. data: [{ label, value, color }]
+export default function DonutChart({ data, centerValue, centerLabel, title }) {
+  const total = data.reduce((n, d) => n + d.value, 0)
+  const R = 62
+  const C = 2 * Math.PI * R
+  const gap = data.filter((d) => d.value > 0).length > 1 ? 5 : 0
+
+  let offset = 0
+  const segs = data.filter((d) => d.value > 0).map((d) => {
+    const len = (d.value / total) * C
+    const seg = { ...d, len, offset }
+    offset += len
+    return seg
+  })
+
+  return (
+    <div className="donut">
+      <svg viewBox="0 0 160 160" className="donut-svg" role="img" aria-label={title}>
+        <circle cx="80" cy="80" r={R} fill="none" strokeWidth="18" style={{ stroke: 'var(--line)' }} />
+        {segs.map((s) => (
+          <circle key={s.label} cx="80" cy="80" r={R} fill="none" strokeWidth="18" transform="rotate(-90 80 80)"
+            strokeDasharray={`${Math.max(0, s.len - gap)} ${C}`} strokeDashoffset={-s.offset} style={{ stroke: s.color }}>
+            <title>{`${s.label}: ${s.value}`}</title>
+          </circle>
+        ))}
+        <text x="80" y="79" textAnchor="middle" className="donut-val">{centerValue}</text>
+        <text x="80" y="98" textAnchor="middle" className="donut-lbl">{centerLabel}</text>
+      </svg>
+      <ul className="donut-legend">
+        {data.map((d) => (
+          <li key={d.label}><span className="ring" style={{ borderColor: d.color }} /><span>{d.label}</span><b>{d.value}</b></li>
+        ))}
+      </ul>
+    </div>
+  )
+}
diff --git a/client/src/lib/stats.js b/client/src/lib/stats.js
new file mode 100644
index 0000000..4eec278
--- /dev/null
+++ b/client/src/lib/stats.js
@@ -0,0 +1,28 @@
+import { formatIp } from '../ip.js'
+
+// One colour per device type, used by the charts and the sidebar.
+export const TYPE_COLORS = {
+  Router: '#22d3c5', Switch: '#3b82f6', Server: '#8b5cf6', PC: '#ff5ec7', Printer: '#f5a45d', Phone: '#34d399', Other: '#94a3b8',
+}
+export const typeColor = (type) => TYPE_COLORS[type] || TYPE_COLORS.Other
+
+export function countBy(devices, key) {
+  const out = {}
+  for (const d of devices) out[d[key]] = (out[d[key]] || 0) + 1
+  return out
+}
+
+// Splits the subnet's usable addresses into 8 equal blocks and counts the used ones in each.
+export function blockUsage(subnet, devices, blocks = 8) {
+  if (!subnet) return []
+  const span = subnet.lastNum - subnet.firstNum + 1
+  const size = Math.max(1, Math.ceil(span / blocks))
+  const out = []
+  for (let i = 0; i < blocks; i++) {
+    const from = subnet.firstNum + i * size
+    if (from > subnet.lastNum) break
+    const to = Math.min(subnet.lastNum, from + size - 1)
+    out.push({ label: '.' + formatIp(from).split('.')[3], value: devices.filter((d) => d.ipNum >= from && d.ipNum <= to).length })
+  }
+  return out
+}
