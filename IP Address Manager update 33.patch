diff --git a/client/src/lib/csv.js b/client/src/lib/csv.js
new file mode 100644
index 0000000..94a3961
--- /dev/null
+++ b/client/src/lib/csv.js
@@ -0,0 +1,15 @@
+// Turns a list of devices into CSV text and downloads it.
+export function toCsv(rows) {
+  const q = (v) => `"${String(v).replace(/"/g, '""')}"`
+  const lines = rows.map((d) => [d.ip, d.name, d.type, d.status, d.notes].map(q).join(','))
+  return ['IP address,Name,Type,Assignment,Notes', ...lines].join('\n')
+}
+
+export function downloadCsv(rows, filename = 'devices.csv') {
+  const url = URL.createObjectURL(new Blob([toCsv(rows)], { type: 'text/csv' }))
+  const a = document.createElement('a')
+  a.href = url
+  a.download = filename
+  a.click()
+  URL.revokeObjectURL(url)
+}
