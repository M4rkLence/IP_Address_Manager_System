diff --git a/client/src/components/AuthForm.jsx b/client/src/components/AuthForm.jsx
new file mode 100644
index 0000000..6b23e4f
--- /dev/null
+++ b/client/src/components/AuthForm.jsx
@@ -0,0 +1,71 @@
+import { useState } from 'react'
+
+export default function AuthForm({ onSubmit }) {
+  const [mode, setMode] = useState('login')
+  const [username, setUsername] = useState('')
+  const [password, setPassword] = useState('')
+  const [confirm, setConfirm] = useState('')
+  const [error, setError] = useState('')
+  const [busy, setBusy] = useState(false)
+  const register = mode === 'register'
+
+  async function submit(e) {
+    e.preventDefault()
+    setError('')
+    if (register && password !== confirm) return setError('Passwords do not match.')
+    setBusy(true)
+    try {
+      await onSubmit(mode, { username, password })
+    } catch (err) {
+      setError(err.message)
+      setBusy(false)
+    }
+  }
+
+  function switchMode() {
+    setMode(register ? 'login' : 'register')
+    setError('')
+    setPassword('')
+    setConfirm('')
+  }
+
+  return (
+    <main className="authpage">
+      <h1>IP address manager</h1>
+      <p className="sub">
+        {register ? 'Create an account. Your devices and IP list stay private to you.' : 'Log in to see your own IP addresses.'}
+      </p>
+      <form className="form" onSubmit={submit}>
+        <h2>{register ? 'Register' : 'Log in'}</h2>
+        <label>Username
+          <input value={username} onChange={(e) => setUsername(e.target.value)}
+            autoComplete="username" autoCapitalize="none" required />
+        </label>
+        <label>Password
+          <input type="password" value={password} onChange={(e) => setPassword(e.target.value)}
+            autoComplete={register ? 'new-password' : 'current-password'}
+            minLength={register ? 8 : undefined} required />
+        </label>
+        {register && (
+          <label>Confirm password
+            <input type="password" value={confirm} onChange={(e) => setConfirm(e.target.value)}
+              autoComplete="new-password" required />
+          </label>
+        )}
+        {register && <p className="hint">Use at least 8 characters.</p>}
+        {error && <p className="error" role="alert">{error}</p>}
+        <div className="actions">
+          <button type="submit" className="primary" disabled={busy}>
+            {busy ? 'Please wait...' : register ? 'Create account' : 'Log in'}
+          </button>
+        </div>
+      </form>
+      <p className="switch">
+        {register ? 'Already have an account? ' : 'New here? '}
+        <button type="button" className="link" onClick={switchMode}>
+          {register ? 'Log in' : 'Create an account'}
+        </button>
+      </p>
+    </main>
+  )
+}
