     const user = currentUser(req)
     if (!user) return send(res, 401, { error: 'Please log in.' })
 
+    // ---------- departments ----------
+    if (path === '/api/departments' && method === 'GET') return send(res, 200, listDepartments(user.id))
+
+    if (path === '/api/departments' && method === 'POST') {
+      const { error, value } = validateName(await readJson(req), 'Department')
+      if (error) return send(res, 400, { error })
+      if (findDepartmentByName(user.id, value.name)) return send(res, 409, { error: `The department "${value.name}" already exists.` })
+      return send(res, 201, createDepartment(user.id, value.name))
+    }
+
+    const dm = path.match(/^\/api\/departments\/(\d+)$/)
+    if (dm) {
+      const id = Number(dm[1])
+      if (!getDepartment(id, user.id)) return send(res, 404, { error: 'Department not found.' })
+      if (method === 'PUT') {
+        const { error, value } = validateName(await readJson(req), 'Department')
+        if (error) return send(res, 400, { error })
+        const same = findDepartmentByName(user.id, value.name)
+        if (same && same.id !== id) return send(res, 409, { error: `The department "${value.name}" already exists.` })
+        return send(res, 200, renameDepartment(id, user.id, value.name))
+      }
+      if (method === 'DELETE') { deleteDepartment(id, user.id); return send(res, 204, null) }
+    }
+
+    // ---------- routers ----------
+    if (path === '/api/routers' && method === 'GET') return send(res, 200, listRouters(user.id))
+
+    if (path === '/api/routers' && method === 'POST') {
+      const body = await readJson(req)
+      const { error, value } = validateName(body, 'Router')
+      if (error) return send(res, 400, { error })
+      const dep = getDepartment(Number(body.departmentId), user.id)
+      if (!dep) return send(res, 400, { error: 'Choose a department for the router.' })
+      if (findRouterByName(dep.id, value.name)) return send(res, 409, { error: `${dep.name} already has a router named "${value.name}".` })
+      return send(res, 201, createRouter(user.id, dep.id, value.name))
+    }
+
+    const rm = path.match(/^\/api\/routers\/(\d+)$/)
+    if (rm) {
+      const id = Number(rm[1])
+      const router = getRouter(id, user.id)
+      if (!router) return send(res, 404, { error: 'Router not found.' })
+      if (method === 'PUT') {
+        const { error, value } = validateName(await readJson(req), 'Router')
+        if (error) return send(res, 400, { error })
+        const same = findRouterByName(router.departmentId, value.name)
+        if (same && same.id !== id) return send(res, 409, { error: `${router.departmentName} already has a router named "${value.name}".` })
+        return send(res, 200, renameRouter(id, user.id, value.name))
+      }
+      if (method === 'DELETE') { deleteRouter(id, user.id); return send(res, 204, null) }
+    }
+
     if (path === '/api/devices' && method === 'GET') return send(res, 200, listDevices(user.id))
 
     if (path === '/api/devices' && method === 'POST') {
