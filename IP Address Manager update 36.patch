@@ -26,3 +26,29 @@ export function blockUsage(subnet, devices, blocks = 8) {
   }
   return out
 }
+
+const utc = (s) => new Date(s.replace(' ', 'T') + 'Z') // the server stores UTC
+const dayKey = (d) => `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`
+
+// Running totals of static and DHCP devices for each of the last `days` days.
+export function growthSeries(devices, days = 14) {
+  const today = new Date()
+  today.setHours(0, 0, 0, 0)
+  const dates = Array.from({ length: days }, (_, i) => {
+    const d = new Date(today)
+    d.setDate(d.getDate() - (days - 1 - i))
+    return d
+  })
+  const keys = dates.map(dayKey)
+  const added = { static: Array(days).fill(0), dhcp: Array(days).fill(0) }
+  const before = { static: 0, dhcp: 0 }
+  for (const dev of devices) {
+    const created = dev.createdAt ? utc(dev.createdAt) : today
+    const idx = keys.indexOf(dayKey(created))
+    if (idx >= 0) added[dev.status][idx]++
+    else if (created < dates[0]) before[dev.status]++
+    else added[dev.status][days - 1]++
+  }
+  const running = (arr, base) => arr.map((_, i) => base + arr.slice(0, i + 1).reduce((a, b) => a + b, 0))
+  return { dates, static: running(added.static, before.static), dhcp: running(added.dhcp, before.dhcp) }
+}
