Subject: [PATCH] IP Address Manager update 4

---
 server/validate.js | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)
 create mode 100644 server/validate.js

diff --git a/server/validate.js b/server/validate.js
new file mode 100644
index 0000000..33f8cd2
--- /dev/null
+++ b/server/validate.js
@@ -0,0 +1,18 @@
+import { parseIp } from './ip.js'
+import { TYPES, STATUSES } from './db.js'
+
+// Checks the JSON body of POST/PUT. Returns { error } or { value }.
+export function validateDevice(body) {
+  const b = body && typeof body === 'object' ? body : {}
+  const ip = parseIp(b.ip)
+  if (ip === null) return { error: 'IP address is not valid. Use four numbers from 0 to 255, like 192.168.1.10.' }
+  const name = String(b.name ?? '').trim()
+  if (!name) return { error: 'Device name is required.' }
+  if (name.length > 60) return { error: 'Device name must be 60 characters or fewer.' }
+  const type = b.type ?? 'PC'
+  if (!TYPES.includes(type)) return { error: 'Device type must be one of: ' + TYPES.join(', ') + '.' }
+  const status = b.status ?? 'static'
+  if (!STATUSES.includes(status)) return { error: 'Status must be static or dhcp.' }
+  const notes = String(b.notes ?? '').trim().slice(0, 200)
+  return { value: { ip, name, type, status, notes } }
+}
