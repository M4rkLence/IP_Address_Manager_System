Subject: [PATCH] IP Address Manager update 10

---
 client/src/api.js | 22 ++++++++++++++++++++++
 client/src/ip.js  |  3 +++
 2 files changed, 25 insertions(+)
 create mode 100644 client/src/api.js
 create mode 100644 client/src/ip.js

diff --git a/client/src/api.js b/client/src/api.js
new file mode 100644
index 0000000..33341fa
--- /dev/null
+++ b/client/src/api.js
@@ -0,0 +1,22 @@
+async function request(path, options = {}) {
+  const res = await fetch('/api' + path, {
+    headers: { 'Content-Type': 'application/json' },
+    ...options,
+  })
+  const data = res.status === 204 ? null : await res.json().catch(() => null)
+  if (!res.ok) {
+    const err = new Error((data && data.error) || 'Request failed.')
+    err.suggestion = data && data.suggestion
+    throw err
+  }
+  return data
+}
+
+export const api = {
+  listDevices: () => request('/devices'),
+  types: () => request('/types'),
+  createDevice: (d) => request('/devices', { method: 'POST', body: JSON.stringify(d) }),
+  updateDevice: (id, d) => request(`/devices/${id}`, { method: 'PUT', body: JSON.stringify(d) }),
+  deleteDevice: (id) => request(`/devices/${id}`, { method: 'DELETE' }),
+  subnet: (cidr) => request('/subnet?cidr=' + encodeURIComponent(cidr)),
+}
diff --git a/client/src/ip.js b/client/src/ip.js
new file mode 100644
index 0000000..923350a
--- /dev/null
+++ b/client/src/ip.js
@@ -0,0 +1,3 @@
+export function formatIp(n) {
+  return [n >>> 24, (n >>> 16) & 255, (n >>> 8) & 255, n & 255].join('.')
+}
